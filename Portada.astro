---
import { perfil, disenos, fotos, short, audio } from '../data/portafolio';

type Clip = { nombre: string; href: string; inicio: number; fin: number };

// Posiciones en % de la secuencia. Solo es composición visual.
const posDisenos = [[1, 21], [23, 45], [47, 66], [69, 93]];
const posFotos = [[7, 31], [35, 57], [61, 86]];

const pistas: { id: string; nombre: string; tipo: string; clips: Clip[] }[] = [
  {
    id: 'V3',
    nombre: 'Short',
    tipo: 'video',
    clips: [{ nombre: short.titulo, href: '#video', inicio: 14, fin: 72 }],
  },
  {
    id: 'V2',
    nombre: 'Diseño',
    tipo: 'diseno',
    clips: disenos.map((d, i) => ({
      nombre: d.titulo,
      href: `#diseno-${i + 1}`,
      inicio: posDisenos[i]?.[0] ?? 0,
      fin: posDisenos[i]?.[1] ?? 10,
    })),
  },
  {
    id: 'V1',
    nombre: 'Foto',
    tipo: 'foto',
    clips: fotos.map((f, i) => ({
      nombre: f.titulo,
      href: `#foto-${i + 1}`,
      inicio: posFotos[i]?.[0] ?? 0,
      fin: posFotos[i]?.[1] ?? 10,
    })),
  },
  {
    id: 'A1',
    nombre: 'Audio',
    tipo: 'audio',
    clips: [{ nombre: audio.titulo, href: '#audio', inicio: 4, fin: 96 }],
  },
];

const marcas = ['00:00', '00:15', '00:30', '00:45', '01:00'];

// Onda decorativa para el clip de audio (determinista, sin aleatorio)
const barras = Array.from({ length: 120 }, (_, i) => {
  const v = Math.abs(Math.sin(i * 0.37) * 0.6 + Math.sin(i * 0.11) * 0.4);
  return Math.max(0.12, Math.min(1, v));
});
---

<section class="portada" id="inicio">
  <div class="contenedor portada__texto">
    <h1 class="portada__nombre">
      <span>Alejandro</span>
      <span>Medina</span>
      <span>Valdés</span>
    </h1>
    <div class="portada__bajada">
      <p class="portada__titulo">{perfil.titulo}</p>
      <p class="portada__resumen">{perfil.resumen}</p>
      <div class="portada__acciones">
        <a class="boton boton--lleno" href="#trabajo">Ver trabajo</a>
        <a class="boton boton--borde" href="#contacto">Escribirme</a>
      </div>
    </div>
  </div>

  <div class="contenedor">
    <figure class="linea" aria-labelledby="linea-ayuda">
      <div class="linea__regla" aria-hidden="true">
        <span class="linea__esquina"></span>
        <div class="linea__marcas">
          {marcas.map((m) => <span>{m}</span>)}
        </div>
      </div>

      <div class="linea__pistas">
        {
          pistas.map((p) => (
            <div class="linea__pista" style={`--color-pista: var(--${p.tipo})`}>
              <span class="linea__etiqueta">
                <b>{p.id}</b>
                <span>{p.nombre}</span>
              </span>
              <div class="linea__carril">
                {p.clips.map((c, i) => (
                  <a
                    class={`linea__clip linea__clip--${p.tipo}`}
                    href={c.href}
                    aria-label={`${p.nombre}: ${c.nombre}`}
                    style={`--inicio:${c.inicio}%; --fin:${c.fin}%; --orden:${i}`}
                  >
                    {p.tipo === 'audio' && (
                      <svg class="linea__onda" viewBox="0 0 120 20" preserveAspectRatio="none" aria-hidden="true">
                        {barras.map((b, j) => (
                          <rect x={j} y={10 - b * 9} width="0.6" height={b * 18} />
                        ))}
                      </svg>
                    )}
                    <span class="linea__clip-nombre">{c.nombre}</span>
                  </a>
                ))}
              </div>
            </div>
          ))
        }
        <div class="linea__cabezal" aria-hidden="true"><span></span></div>
      </div>

      <figcaption id="linea-ayuda" class="linea__ayuda">
        Cada pista es un tipo de trabajo. Haz clic en un clip para ir a esa pieza.
      </figcaption>
    </figure>
  </div>
</section>

<script>
  // Un solo valor, --progreso (0 a 1), mueve el cabezal de la portada,
  // la barra del encabezado y el timecode.
  const raiz = document.documentElement;
  const timecode = document.querySelector<HTMLElement>('[data-timecode]');
  const FPS = 24;
  const DURACION = 60; // la página entera "dura" un minuto
  const pad = (n: number) => String(n).padStart(2, '0');

  let pendiente = false;
  function actualizar() {
    pendiente = false;
    const max = raiz.scrollHeight - innerHeight;
    const p = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
    raiz.style.setProperty('--progreso', p.toFixed(4));
    if (timecode) {
      const cuadros = Math.round(p * DURACION * FPS);
      const s = Math.floor(cuadros / FPS);
      timecode.textContent = `00:${pad(Math.floor(s / 60))}:${pad(s % 60)}:${pad(cuadros % FPS)}`;
    }
  }
  addEventListener('scroll', () => {
    if (!pendiente) {
      pendiente = true;
      requestAnimationFrame(actualizar);
    }
  }, { passive: true });
  addEventListener('resize', actualizar);
  actualizar();
</script>

<style>
  .portada {
    padding-block: clamp(3rem, 8vw, 6rem) clamp(3rem, 7vw, 5rem);
  }

  .portada__texto {
    display: grid;
    grid-template-columns: 1fr minmax(18rem, 26rem);
    gap: 2rem 3rem;
    align-items: end;
  }

  .portada__nombre {
    display: flex;
    flex-direction: column;
    font-size: clamp(3.25rem, 11.5vw, 10rem);
    font-weight: 850;
    line-height: 0.88;
    letter-spacing: -0.01em;
  }

  .portada__nombre span:nth-child(2) {
    padding-left: 0.6em;
  }

  .portada__titulo {
    font-family: var(--display);
    font-stretch: 112%;
    font-weight: 750;
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .portada__resumen {
    color: var(--tinta-suave);
    font-size: 1.1875rem;
  }

  .portada__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  /* ── Línea de tiempo ─────────────────────────── */
  .linea {
    --etiqueta: 6.5rem;
    margin: clamp(2.5rem, 6vw, 4.5rem) 0 0;
    background: var(--tinta);
    color: var(--papel);
    border-radius: 6px;
    padding: 0.75rem 0.75rem 1rem;
    font-family: var(--display);
    font-stretch: 100%;
  }

  .linea__regla {
    display: grid;
    grid-template-columns: var(--etiqueta) 1fr;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    color: #9fb0c8;
    margin-bottom: 0.4rem;
  }

  .linea__marcas {
    display: flex;
    justify-content: space-between;
    padding-bottom: 0.35rem;
    background-image: repeating-linear-gradient(
      to right,
      #4a6488 0 1px,
      transparent 1px calc(100% / 20)
    );
    background-size: 100% 5px;
    background-position: bottom;
    background-repeat: no-repeat;
  }

  .linea__pistas {
    position: relative;
    display: grid;
    gap: 4px;
  }

  .linea__pista {
    display: grid;
    grid-template-columns: var(--etiqueta) 1fr;
    gap: 0.5rem;
    align-items: stretch;
  }

  .linea__etiqueta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    padding: 0 0.5rem;
    background: #1b3a63;
    border-radius: var(--radio);
    border-left: 4px solid var(--color-pista);
  }

  .linea__etiqueta b {
    font-variant-numeric: tabular-nums;
  }

  .linea__carril {
    position: relative;
    height: 2.75rem;
    background: #173459;
    border-radius: var(--radio);
  }

  .linea__pista:last-of-type .linea__carril {
    height: 3.5rem;
  }

  .linea__clip {
    position: absolute;
    top: 3px;
    bottom: 3px;
    left: var(--inicio);
    width: calc(var(--fin) - var(--inicio));
    display: flex;
    align-items: flex-start;
    padding: 0.3rem 0.5rem;
    overflow: hidden;
    border-radius: var(--radio);
    background: var(--color-pista);
    color: var(--tinta);
    font-size: 0.8125rem;
    font-weight: 650;
    text-decoration: none;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.35);
    transform-origin: left;
    animation: entra 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
    animation-delay: calc(0.15s + var(--orden) * 0.08s);
  }

  .linea__clip:hover {
    filter: brightness(1.08);
    box-shadow: inset 0 0 0 2px var(--papel-alto);
  }

  .linea__clip-nombre {
    position: relative;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .linea__onda {
    position: absolute;
    inset: 1.4rem 0.4rem 0.3rem;
    width: calc(100% - 0.8rem);
    height: calc(100% - 1.7rem);
    fill: #1f6b4f;
  }

  .linea__cabezal {
    position: absolute;
    top: -0.9rem;
    bottom: -0.25rem;
    left: calc(var(--etiqueta) + 0.5rem);
    right: 0;
    pointer-events: none;
  }

  .linea__cabezal span {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--progreso, 0) * 100%);
    width: 2px;
    margin-left: -1px;
    background: var(--cabezal);
    animation: barrido 1.1s cubic-bezier(0.6, 0, 0.2, 1) backwards;
  }

  .linea__cabezal span::before {
    content: '';
    position: absolute;
    top: 0;
    left: -5px;
    width: 12px;
    height: 12px;
    background: var(--cabezal);
    clip-path: polygon(0 0, 100% 0, 100% 55%, 50% 100%, 0 55%);
  }

  .linea__ayuda {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: #9fb0c8;
  }

  /* El único momento animado: los clips caen en la pista y el cabezal recorre la secuencia */
  @keyframes entra {
    from {
      transform: scaleX(0);
      opacity: 0;
    }
  }

  @keyframes barrido {
    from {
      left: 100%;
    }
  }

  @media (max-width: 56rem) {
    .portada__texto {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 40rem) {
    .linea {
      --etiqueta: 2.25rem;
      padding: 0.5rem 0.5rem 0.75rem;
    }
    .linea__etiqueta {
      padding: 0 0.3rem;
      border-left-width: 3px;
    }
    .linea__etiqueta span {
      display: none;
    }
    .linea__clip-nombre {
      display: none;
    }
    .linea__carril {
      height: 2rem;
    }
    .linea__pista:last-of-type .linea__carril {
      height: 2.5rem;
    }
    .linea__onda {
      inset: 0.3rem;
      width: calc(100% - 0.6rem);
      height: calc(100% - 0.6rem);
    }
  }
</style>
